# ─── کپی این فایل به .env و مقادیر واقعی را جایگزین کن ─────────────────────
# cp .env.example .env

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_this_strong_password_123

# ── Database URL (اجباری — بدون این container کرش میکند) ─────────────────────
# در Coolify: از طریق سرویس PostgreSQL این متغیر ست کن
# مثال: postgresql://postgres:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql://postgres:change_this_strong_password_123@db:5432/beewaz

# ── Next.js Auth ──────────────────────────────────────────────────────────────
# تولید: openssl rand -base64 32
AUTH_SECRET=replace_with_32_char_random_string_here

# ── URL سایت (در production آدرس واقعی دامنه) ────────────────────────────────
NEXT_PUBLIC_APP_URL=https://beewaz.ir
NEXTAUTH_URL=https://beewaz.ir

# ── ادمین ──────────────────────────────────────────────────────────────────────
ADMIN_PHONE=09120000000
ADMIN_NAME=مدیر سیستم
# توکن ورود به پنل ادمین (اجباری در production)
# تولید: openssl rand -hex 32
ADMIN_TOKEN=replace_with_strong_random_token

# توکن مسیر /api/cron/* — صدا زده می‌شود توسط GitHub Actions (workflow جدا از deploy.yml)
# همین مقدار را هم در سرور (env) و هم در GitHub repo secrets با نام CRON_SECRET ست کن
# تولید: openssl rand -hex 32
CRON_SECRET=replace_with_strong_random_token

# ── درگاه پرداخت ──────────────────────────────────────────────────────────────
# زرین‌پال
ZARINPAL_MERCHANT_ID=your-zarinpal-merchant-id
ZARINPAL_SANDBOX=false
# آی‌دی‌پی
IDPAY_API_KEY=your-idpay-api-key
IDPAY_SANDBOX=false

# ── SMS.ir (پیامک) ───────────────────────────────────────────────────────────
SMS_IR_API_KEY=your_sms_ir_api_key
SMS_IR_LINE_NUMBER=10000047956

# ── دستیار هوش مصنوعی (چت‌بات سایت + دستیار سئو + دستیار محتوای محصول) ────────
# هر سرویس OpenAI-compatible کار می‌کند — مثلاً GapGPT
# AI_BASE_URL=https://api.gapgpt.app/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# ── Phase E: دستیار صوتی فارسی ───────────────────────────────────────────────
# provider فعلی از Web Speech API خود مرورگر استفاده می‌کند و هیچ کلید API
# یا secret سمت client نیاز ندارد. برای kill-switch سریع VOICE_ENABLED=false بگذار.
VOICE_ENABLED=true
VOICE_PROVIDER=browser

# Phase E3 — حلقه مکالمه hands-free با BEE
# خاموش کردن فوری مکالمه رفت‌وبرگشتی بدون غیرفعال کردن voice fallback:
BEE_HANDSFREE_ENABLED=true
# فاصله سکوت بعد از آخرین transcript که پایان نوبت مشتری در نظر گرفته می‌شود (ms)
# مقدار در runtime بین 600 تا 3000 clamp می‌شود.
BEE_TURN_SILENCE_MS=1200

# Phase E4 — barge-in واقعی با VAD مرورگر
# تا قبل از smoke test روی موبایل production خاموش بماند.
BEE_BARGE_IN_ENABLED=false

# ── تنظیمات قدیمی (سازگاری) ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=بیواز
